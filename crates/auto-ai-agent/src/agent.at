/// The autonomous agent (Layer 3 core).
///
/// An Agent binds a Role (personality), a ToolRegistry (capabilities), a Memory
/// (conversation), and a Client (LLM transport) into a single ReAct loop in
/// Agent.run.
///
/// The LLM transport is abstracted behind the Client spec so the loop can be
/// driven by the real auto_ai_client.AiClient in production OR a deterministic
/// mock in tests.
///
/// Auto port of crates/auto-ai-agent/src/agent.rs (auto-ai v0.4.0).
///
/// STATUS — ReAct loop ported; streaming via Auto actor sink (Plan 021 缺口 1,
/// 2026-08-05): This file ports the full type surface (Client spec, StreamEvent,
/// AgentResult, ToolCallRecord, the Agent struct, truncate_tool_result, public
/// accessors) AND the ReAct loop (run / run_stream / run_inner / build_request).
///
/// ARCHITECTURE (streaming — Plan 022 follow-up, auto-lang Plan 397): the loop
/// now mirrors rust-ref: `run_inner` calls `Client.complete_stream(req, cb)`
/// where `cb` is an `Arc<Fn(JsonValue)>` (Plan 397 confirmed this works as a spec
/// method parameter). The cb forwards each SSE text delta to the EventSink actor
/// as `StreamEvent.Delta` (per-token streaming). The Client spec's
/// `complete_stream` has a default impl that falls back to non-streaming
/// `complete` + one synthetic delta, so test mocks stay simple.
///
/// Event delivery uses an **Auto actor sink** (auto-lang Plan 387 §16/17):
/// `run_stream` takes a `TaskRef<StreamEvent>` handle (spawned from `EventSink`,
/// defined below) and every event point does `sink.send(...)`. `run` spawns a
/// throwaway sink so the loop body is sink-only (mirrors rust-ref's "on_event is
/// always a sink", review-003 M4). The sink handler forwards each event to `cb` —
/// a `Box<dyn Fn(StreamEvent)>` closure (Plan 390 §15.10) injected at spawn.
/// Tool execution stays async (`execute ~Result<str,ToolError>`).
///
/// Other Auto-side adaptations (none affect behavior):
///   - generic `fn new<P: Role>(role P, ...)` → `new_shared(role Role, ...)` with
///     a spec-typed field (Auto `spec` is auto-dyn, equivalent to Arc<dyn Role>).
///   - `StreamEvent.Thinking` (rust-ref's reasoning-event variant) is NOT yet
///     ported — the cb currently forwards all text as Delta (Plan 022 §6.1
///     conservative increment; reasoning distinction is a follow-up).
///
/// VARIANT NOTE: StreamEvent's struct-style variants are modeled as tuple
/// variants (plan 013 gotcha B3). Field order:
/// - StreamEvent.Delta(text)
/// - StreamEvent.ToolStart(tool, args)
/// - StreamEvent.Warning(text)
/// - StreamEvent.Tool(tool, args, result)
/// - StreamEvent.Done(result)
/// - StreamEvent.Cancelled(result)
/// - StreamEvent.Error(message)

use.rust std::sync::Arc
use.rust std::sync::atomic::AtomicBool
use.rust std::sync::atomic::Ordering
use.rust std::future::Future
use.rust std::pin::Pin
use.rust async_trait
use.rust serde_json

use auto_ai_client: ClientError, CompletionRequest, CompletionResponse, Message
use error: AgentError
use memory: Memory
use role_def: Role
use skill: SkillTool
use ai_config: ModelTier
use tool: ToolRegistry, tool_to_definition, Tool
use wire: ContentBlock, JsonValue, ToolDefinition

// ═══════════════════════════════════════════════════════════════════════════
// Constants (Auto has no `pub const`; exposed via functions)
// ═══════════════════════════════════════════════════════════════════════════

/// After how many identical (tool, args) repeats the loop bails out as a cycle.
fn loop_detect_threshold() uint {
    return 3
}

/// Maximum chars of a tool result stored in memory (~5k tokens). Tool outputs
/// longer than this are truncated (with a notice) so a single read_file of a
/// huge file can't blow out the context window for the rest of the run.
fn max_tool_result_chars() uint {
    return 20000
}

/// Truncate a tool result to max_tool_result_chars(), appending a notice when
/// truncation happened. Returns the (possibly truncated) string.
pub fn truncate_tool_result(s str) str {
    let cap = max_tool_result_chars()
    let count = s.len() as uint
    if count <= cap {
        return s
    }
    let kept = s.substring(0, cap)
    let dropped = count - cap
    return f"${kept}\n…[truncated ${dropped} more chars]"
}

// ═══════════════════════════════════════════════════════════════════════════
// Client spec (the LLM transport)
// ═══════════════════════════════════════════════════════════════════════════

/// The LLM transport an Agent talks to.
///
/// Abstracts auto_ai_client.AiClient so the ReAct loop can be unit-tested with
/// a deterministic mock.
///
/// complete_stream (Plan 022 follow-up, auto-lang Plan 397): takes an
/// `Arc<Fn(JsonValue)>` callback invoked per SSE event the daemon emits. The
/// real AiClient adapter (client_impl.rs) overrides it with true SSE streaming;
/// test mocks implement it via the `default_complete_stream` helper (a free fn
/// in client_impl.rs) since spec default bodies can't call self methods
/// (a2r DIV-TRAIT-A2R-3 known gap).
pub spec Client: Send + Sync {
    /// One non-streaming completion request.
    fn complete(req CompletionRequest) ~Result<CompletionResponse, ClientError>

    /// Streaming completion. Calls `on_event` for each SSE event the daemon
    /// emits (a JsonValue like {"type":"delta","text":"…"}). Returns the
    /// accumulated full response on success.
    fn complete_stream(req CompletionRequest, on_event Arc<Fn(JsonValue)>) ~Result<CompletionResponse, ClientError>
}

// ═══════════════════════════════════════════════════════════════════════════
// StreamEvent
// ═══════════════════════════════════════════════════════════════════════════

/// Events emitted by Agent.run_stream as the ReAct loop progresses.
/// Tuple variants (plan 013 gotcha B3) — see file header for field order.
pub enum StreamEvent {
    /// A chunk of the model's text output. (text)
    Delta(str)
    /// A tool is about to be executed. (tool, args)
    ToolStart(str, JsonValue)
    /// A non-fatal advisory message (e.g. the near-turn-cap warning). (text)
    Warning(str)
    /// A tool was called and produced a result. (tool, args, result)
    Tool(str, JsonValue, str)
    /// The loop finished successfully (carries the full result). (result)
    Done(AgentResult)
    /// The run was cancelled by the user. (result)
    Cancelled(AgentResult)
    /// The loop failed. (message)
    Error(str)
}

// ═══════════════════════════════════════════════════════════════════════════
// EventSink actor (Plan 021 缺口 1 — streaming via Auto actor)
// ═══════════════════════════════════════════════════════════════════════════

/// A sink actor that consumes `StreamEvent`s sent by `Agent.run_stream`.
///
/// Callers spawn it with a forwarding callback and pass the handle to `run_stream`:
///   let sink = Task.spawn("EventSink", 64, Box((ev) => forward(ev)))
///   let result = agent.run_stream(task, cancel, sink).await.?
/// The callback (a `Box<dyn Fn(StreamEvent)>` — Plan 390 §15.10) is injected at
/// spawn via the `_with` init arg (a closure capturing the app's event handler);
/// `run` (non-streaming) spawns with all-default args so the no-op closure
/// default consumes events without forwarding.
///
/// The handler destructures every event variant, accumulates a compact text log
/// in its state, AND forwards the whole event to `cb` (Plan 390 §6.7 — the cb
/// injection mechanism, unblocking sink→app forwarding). The default cb is an
/// empty closure literal (Plan 390 §15.10 transpiles it to
/// `Box::new(move |..| { .. })` — a `Box<dyn Fn>` field).
task EventSink {
    log = f""
    cb = fn(e StreamEvent) { }
    on {
        ev StreamEvent -> {
            // Forward a clone to cb first (the cb owns its copy), then destructure
            // + log from the original ev. clone() is available (StreamEvent derives
            // Clone); without it, `(self.cb)(ev)` would move ev and the is-match
            // below couldn't borrow it.
            (self.cb)(ev.clone())
            is ev {
                StreamEvent.Delta(text) -> {
                    log = f"${log}D:${text};"
                },
                StreamEvent.ToolStart(tool, _args) -> {
                    log = f"${log}TS:${tool};"
                },
                StreamEvent.Warning(text) -> {
                    log = f"${log}W:${text};"
                },
                StreamEvent.Tool(tool, _args, _result) -> {
                    log = f"${log}T:${tool};"
                },
                StreamEvent.Done(result) -> {
                    log = f"${log}DONE:${result.output};"
                },
                StreamEvent.Cancelled(result) -> {
                    log = f"${log}CANCEL:${result.output};"
                },
                StreamEvent.Error(message) -> {
                    log = f"${log}E:${message};"
                }
            }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// ToolCallRecord / AgentResult
// ═══════════════════════════════════════════════════════════════════════════

/// A record of one tool call made during a run (for diagnostics/results).
pub type ToolCallRecord {
    tool str
    args JsonValue
    result str
}

/// The outcome of Agent.run.
pub type AgentResult {
    /// The agent's final textual answer.
    output str
    /// How many ReAct turns the loop ran.
    turns uint
    /// Every tool call the agent made, in order.
    tool_calls List<ToolCallRecord>
    /// Total tokens consumed (if the transport reports usage).
    total_tokens uint
}

ext AgentResult {
    pub static fn default() AgentResult {
        return AgentResult(output: "", turns: 0, tool_calls: [], total_tokens: 0)
    }

    /// The accumulated text content (alias used by the driver for handoff
    /// summaries). Mirrors the Rust driver's `collected` buffer.
    pub fn content() str {
        return self.output
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Agent
// ═══════════════════════════════════════════════════════════════════════════

/// An autonomous agent that drives an LLM toward a goal via a ReAct loop.
///
/// NOTE: `role` and `client` are spec-typed fields (Auto `spec` is dynamically
/// dispatched, equivalent to Rust's `Arc<dyn Role>` / `Arc<dyn Client>`). The
/// Rust `new<P: Role + 'static>(role P, ...)` generic constructor is not
/// portable to Auto (generic methods are a parse error) — construction goes
/// through Agent.new_shared (takes spec values) instead.
pub type Agent {
    role Role
    tools ToolRegistry
    memory Memory
    client Client
    /// Bootstrap block listing available skills (injected into the system
    /// prompt so the model knows what it can invoke). Set by
    /// register_skill_tool.
    skills_block ?str
    /// Project context (e.g. contents of .musk.md / CLAUDE.md). Prepended to
    /// the system prompt so the agent starts with project knowledge.
    context_block ?str
}

ext Agent {
    /// Build a new agent from an already-shared Role + Client spec value, and
    /// the Role's memory-limit preference. (Non-generic substitute for Rust's
    /// `new<P: Role>(role P, client)`.)
    pub static fn new_shared(role Role, client Client) Agent {
        let limit = role.memory_limit()
        return Agent(
            role: role,
            tools: ToolRegistry.new(),
            memory: Memory.new(limit),
            client: client,
            skills_block: None,
            context_block: None
        )
    }

    /// Inject project context (e.g. the contents of .musk.md or CLAUDE.md) into
    /// the system prompt. Prepended before the role's soul.
    //
    // NOTE: the original Rust `with_context(mut self) -> Self` consumes and
    // returns self (builder). Agent holds `Box<dyn Role/Client>` (non-Clone), so
    // a2r can't `return self.clone()`, and `return self` from `&mut self` won't
    // move out. This port mutates in place and returns void. (No internal
    // callers; the chainable form isn't expressible in Auto for non-Clone types.)
    pub mut fn with_context(context str) void {
        let ctx = context.trim()
        if ctx.is_empty() == false {
            self.context_block = Some(context)
        }
    }

    /// Register a tool the agent may call (takes a spec value).
    pub mut fn register_shared(tool Arc<Tool>) void {
        self.tools.register_shared(tool)
    }

    /// Register a tool from a concrete spec value (mirrors rust-ref's
    /// `register_tool<T: Tool + 'static>`). The caller passes a plain struct
    /// value (`agent.register_tool(MyTool{})`) and the registry Arc-wraps it
    /// internally. Call sites auto-box via a2r Plan 390 §11 Phase E
    /// (`register_tool(Box::new(my_tool))`); no manual `Arc::new(Box::new(...))`.
    pub mut fn register_tool(tool Tool) void {
        self.tools.register(tool)
    }

    /// Register a SkillTool AND cache its available-skills block so
    /// build_system_prompt injects the skill directory into the system prompt.
    /// Mirrors rust-ref's register_skill_tool (both register + cache); the
    /// SkillTool also implements Tool, so register_tool handles Arc-wrapping.
    /// (Plan 016 2.2 + Plan 022 Phase 3.1 — previously only cached the block,
    /// leaving skill(...) tool calls as "tool not found".)
    pub mut fn register_skill_tool(tool SkillTool) void {
        let block = tool.available_skills_block()
        is block.len() == 0 {
            true -> self.skills_block = None
            false -> self.skills_block = Some(block)
        }
        // Box(tool) lifts the concrete SkillTool into a Box<dyn Tool> (unsizing
        // coercion at the register_tool call site). a2r renders Box(tool) as
        // Box::new(tool); the spec-param target type Box<dyn Tool> drives coercion.
        self.register_tool(Box(tool))
    }

    // NOTE: `tools()`, `role()`, `client()` accessors from the Rust original
    // (returning &ToolRegistry / &dyn Role / &Arc<dyn Client>) are OMITTED here.
    // Agent holds Box<dyn Role/Client> + a non-Clone ToolRegistry; returning
    // owned copies isn't possible and Auto can't express `&self.field` returns,
    // so a2r would emit a failing `self.X.clone()`. No internal callers exist.

    /// Snapshot of the current conversation memory (for session persistence).
    pub fn memory_messages() List<Message> {
        return self.memory.messages()
    }

    /// Current conversation memory.
    pub fn history() List<Message> {
        return self.memory.messages()
    }

    // ── ReAct loop (streaming via EventSink actor — see file header + 021) ──
    //
    // Every event point sends to the sink (always present: run spawns a
    // throwaway EventSink, run_stream receives the caller's). This mirrors
    // rust-ref's "on_event is always a sink" (review-003 M4) — the loop body
    // never branches on whether a sink exists. Tool execution stays async.

    /// Run the ReAct loop against `task`, returning the agent's final answer.
    /// Non-streaming, non-cancellable (delegates to run_inner with cancel=None
    /// and a throwaway EventSink that consumes the events — nothing observable).
    /// `mut fn`: the loop mutates self.memory/tools.
    pub mut fn run(task_msg str) ~Result<AgentResult, AgentError> {
        // All-default spawn: cb defaults to the no-op closure (Plan 390 §15.10).
        let discard = Task.spawn("EventSink", 16)
        return self.run_inner(task_msg, None, discard).await
    }

    /// Like run, but honors a cancellation flag at the turn boundaries AND
    /// streams every ReAct event to `sink` (Plan 021 缺口 1). The Rust original
    /// takes an `Arc<dyn Fn(StreamEvent)>` callback; the Auto port takes a
    /// `TaskRef<StreamEvent>` actor handle instead (auto-lang Plan 387 §16/17 —
    /// the EventSink task is defined above). The caller spawns the sink with a
    /// forwarding closure (Plan 390 §15.10 Box<dyn Fn>):
    /// `Task.spawn("EventSink", 16, f"", Box((ev) => forward(ev, on_event)))`.
    /// `mut fn`: run_inner mutates self.memory/tools.
    pub mut fn run_stream(task_msg str, cancel Arc<AtomicBool>, sink TaskRef<StreamEvent>) ~Result<AgentResult, AgentError> {
        return self.run_inner(task_msg, Some(cancel), sink).await
    }

    /// Unified ReAct loop backing run + run_stream.
    ///
    /// Each turn: build a request from memory + role, ask the model, execute
    /// any tool calls, feed results back. Stops when the model replies with
    /// plain text (no tool calls), a tool-call cycle is detected
    /// (LOOP_DETECT_THRESHOLD), or the hard safety cap (max_turns * 5) is hit.
    /// The Role's max_turns is a SOFT target — the agent may exceed it while
    /// still making progress; the hard cap is 5x the soft target.
    /// `mut fn`: mutates self.memory (add/add_message) + self.tools.
    pub mut fn run_inner(task_msg str, cancel ?Arc<AtomicBool>, sink TaskRef<StreamEvent>) ~Result<AgentResult, AgentError> {
        self.memory.add("user", task_msg)
        let soft_limit = self.role.max_turns()
        let hard_limit = soft_limit * 5u
        var result = AgentResult.default()
        // Loop detection: count recurrences of each (tool, args) pair.
        var seen Map<str, uint> = Map.new()
        var seen_names List<str> = []

        var turn uint = 0
        for turn < hard_limit {
            // Cancel checkpoint 1: before starting a new turn.
            if is_cancelled(cancel) {
                let ce = cancelled_event(result)
                sink.send(ce)
                return Ok(result)
            }
            turn = turn + 1
            result.turns = turn

            // Near hard cap: warn the model to wrap up (transient, not stored).
            let remaining = hard_limit - turn
            if remaining <= 5 {
                if remaining > 1 {
                    let w = StreamEvent.Warning(f"${remaining - 1} turns until the hard stop — wrap up now.")
                    sink.send(w)
                }
            }

            let req = self.build_request()
            // Streaming request (Plan 022 follow-up, mirrors rust-ref agent.rs:381):
            // complete_stream drives the daemon's SSE; the callback forwards each
            // text delta to the EventSink as StreamEvent.Delta (per-token stream).
            // `move` arrow closure captures a clone of `sink` (TaskRef is Clone —
            // Plan 397 follow-up; the original sink stays usable for the rest of
            // run_inner's turn/tool events). Explicit .clone() because a2r's
            // borrow inference treats `let sink_cb = sink` as a move (Plan 019 D).
            let sink_cb = sink.clone()
            let resp = self.client.complete_stream(req, Arc(move (ev) => forward_sse_delta(ev, sink_cb))).await.?

            // Cancel checkpoint 2: after the LLM responded, before consuming.
            if is_cancelled(cancel) {
                result.total_tokens = record_usage(result, resp)
                let ce = cancelled_event(result)
                sink.send(ce)
                return Ok(result)
            }

            // Business-level error carried in a 200 response.
            is resp.error {
                Some(err) -> {
                    // clone: err is used again in the Config variant below.
                    let ev = StreamEvent.Error(err.clone())
                    sink.send(ev)
                    return Err(AgentError.Config(err))
                },
                None -> {}
            }
            result.total_tokens = record_usage(result, resp)

            if resp.wants_tool() {
                // Cancel checkpoint 3: before recording/executing tool calls.
                if is_cancelled(cancel) {
                    let ce = cancelled_event(result)
                    sink.send(ce)
                    return Ok(result)
                }
                // Record the assistant's tool-use turn so the next request
                // carries it (some providers require tool_use before its
                // tool_result).
                var blocks List<ContentBlock> = []
                if resp.content.is_empty() == false {
                    let tb = ContentBlock.Text(resp.content)
                    blocks.push(tb)
                }
                var tc_idx uint = 0
                // clone: the tool-execution loop below re-reads resp.tool_calls.
                for tc in resp.tool_calls.clone() {
                    let ub = ContentBlock.ToolUse(tc.id, tc.name, tc.input)
                    blocks.push(ub)
                    tc_idx = tc_idx + 1
                }
                if blocks.is_empty() == false {
                    let am = Message(role: "assistant", content: blocks)
                    self.memory.add_message(am)
                }

                // Execute each tool call, record results, feed back to memory.
                // (clone: the first loop moved resp.tool_calls; tc fields are
                // shared across ToolStart/exec/record/event below.)
                var keep_going = true
                for tc in resp.tool_calls.clone() {
                    let key = f"${tc.name}::${tc.input}"
                    let count = bump_seen(seen, seen_names.clone(), key)
                    if count >= loop_detect_threshold() {
                        let ev = StreamEvent.Error(f"loop detected on '${tc.name}'")
                        sink.send(ev)
                        return Err(AgentError.LoopDetected(tc.name))
                    }
                    // ToolStart: signal this tool is about to run.
                    let ts = StreamEvent.ToolStart(tc.name.clone(), tc.input.clone())
                        sink.send(ts)
                    // exec_or_msg takes &str name — tc.name is String.
                    let outcome = self.tools.exec_or_msg(tc.name.as_str(), tc.input.clone()).await
                    let rec = ToolCallRecord(
                        tool: tc.name.clone(), args: tc.input.clone(), result: outcome.clone()
                    )
                    result.tool_calls.push(rec)
                    let tev = StreamEvent.Tool(tc.name, tc.input, outcome.clone())
                    sink.send(tev)
                    // Truncate before storing so one big output can't blow the
                    // context window.
                    let tr = Message.tool_result(tc.id, truncate_tool_result(outcome))
                    self.memory.add_message(tr)
                }
                // Loop continues: ask the model again with the tool results.
            } else {
                // No tool calls → final answer.
                result.output = resp.content.clone()
                // memory.add takes &str content.
                self.memory.add("assistant", resp.content.as_str())
                let done = StreamEvent.Done(clone_result(result))
                sink.send(done)
                return Ok(result)
            }
        }

        // Exceeded hard safety cap without a plain-text answer.
        let err = StreamEvent.Error(f"hard turn cap (${hard_limit}) exceeded (soft limit was ${soft_limit})")
        sink.send(err)
        return Err(AgentError.MaxTurnsExceeded(hard_limit))
    }

    /// Build the completion request for the current turn: system prompt from
    /// the Role, the role's tier/model, the full memory, and the tools the
    /// Role allows.
    pub fn build_request() CompletionRequest {
        let allowed = self.role.allowed_tools()
        let visible = self.tools.filter(allowed)
        var tool_defs List<ToolDefinition> = []
        for t in visible {
            tool_defs.push(tool_to_definition(t))
        }

        // Model selection: a pinned concrete id wins; else emit a tier token
        // ("tier:<tier>") the daemon resolves.
        let pinned = self.role.model()
        let model = build_model_id(pinned, self.role.model_tier())

        let system_prompt = build_system_prompt(
            // system_prompt() returns String but soul param is `str` (&str).
            self.context_block, self.role.system_prompt().as_str(), self.skills_block
        )

        return CompletionRequest(
            model: model,
            messages: self.memory.to_messages(),
            max_tokens: None,
            temperature: Some(self.role.temperature()),
            system_prompt: Some(system_prompt),
            tools: tool_defs,
            stream: false,
            preferred_provider: self.role.preferred_provider()
        )
    }
}

// ─── run_inner / build_request helpers (free fns; defined before use) ───────

/// True when the caller has requested cancellation (cancel flag set + true).
fn is_cancelled(cancel ?Arc<AtomicBool>) bool {
    is cancel {
        None -> return false,
        Some(c) -> {
            // Bridge to std::sync::atomic::AtomicBool::load (SeqCst).
            let v = c.load(Ordering.SeqCst)
            return v
        }
    }
}

/// Increment the recurrence count for a (tool, args) key, returning the new
/// count. Keeps the parallel `seen_names` key list in sync (Auto's VM Map has
/// no iteration API — plan 013 gotcha B5).
fn bump_seen(seen Map<str, uint>, seen_names List<str>, key str) uint {
    var prev uint = 0
    // seen.get(key) returns Option<&u32>; destructure + .clone() to get an owned
    // u32 (a bare `prev = seen.get(key)` assigned Option<&u32> to u32).
    is seen.get(key) {
        Some(n) -> prev = n.clone(),
        None -> seen_names.push(key.to_string())
    }
    let next = prev + 1
    seen.set(key, next)
    return next
}

/// Compute the updated running token total after folding in a response's usage
/// (if any). Returned so the caller assigns it back — a2r clones struct args at
/// call sites, so mutating a `result` param in place wouldn't reach the caller,
/// and the param binding isn't `mut` by default (E0594).
fn record_usage(result AgentResult, resp CompletionResponse) uint {
    is resp.usage {
        Some(u) -> return result.total_tokens + u.total_tokens(),
        None -> return result.total_tokens
    }
}

/// A Cancelled event carrying a snapshot of the current result.
fn cancelled_event(result AgentResult) StreamEvent {
    return StreamEvent.Cancelled(clone_result(result))
}

/// Forward one SSE event (from Client.complete_stream's callback) to the
/// EventSink as a StreamEvent.Delta. Conservative (Plan 022 §6.1): every text
/// chunk becomes Delta; the reasoning→Thinking distinction is a follow-up.
/// Extracted as a free fn so the run_inner closure stays a single-expression
/// arrow closure (a2r parses `(ev) => expr`, not block-body move closures).
/// `@TaskRef` (by ref): TaskRef is not Clone; send takes &self, so a borrow
/// suffices and avoids a2r's move-reuse clone inference (Plan 019 class D).
fn forward_sse_delta(ev JsonValue, sink @TaskRef<StreamEvent>) void {
    is ev.get("text") {
        Some(t) -> {
            let text = t.as_str().unwrap_or("")
            if text.is_empty() == false {
                sink.send(StreamEvent.Delta(text.to_string()))
            }
        },
        None -> {}
    }
}

/// Copy an AgentResult (used for event payloads, so the returned result stays
/// independent of the running accumulator).
fn clone_result(result AgentResult) AgentResult {
    return AgentResult(
        output: result.output,
        turns: result.turns,
        tool_calls: result.tool_calls,
        total_tokens: result.total_tokens
    )
}

/// Build the model id: a pinned id if set, else a "tier:<tier>" token.
fn build_model_id(pinned str, tier ModelTier) str {
    if pinned.is_empty() == false {
        return pinned
    }
    return f"tier:${tier.display_name()}"
}

/// Assemble the system prompt: optional project context + role soul + optional
/// skills directory block.
fn build_system_prompt(context_block ?str, soul str, skills_block ?str) str {
    var prompt = ""
    is context_block {
        Some(ctx) -> {
            if ctx.trim().is_empty() == false {
                prompt = ctx + "\n\n---\n\n"
            }
        },
        None -> {}
    }
    prompt = prompt + soul
    is skills_block {
        Some(block) -> prompt = prompt + block,
        None -> {}
    }
    return prompt
}

