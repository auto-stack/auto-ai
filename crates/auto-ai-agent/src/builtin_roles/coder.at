""" The Coder role.
 Auto port of builtin_roles/coder.rs.
"""

use role_def: Role
use ai_config: ModelTier

""" Soul loaded at transpile time from resources (a2r comptime read_text,
  equivalent to Rust's include_str! — embeds the file content as a string
  constant). Path is relative to the retranspile.sh CWD (crates/auto-ai-agent/).
"""
const SOUL = #{read_text("src/resources/souls/coder.md")}

pub type Coder has Role {
    pub fn name() str { return "coder" }
    pub fn system_prompt() str { return SOUL.to_string() }
    pub fn model_tier() ModelTier { return ModelTier.Max }
    pub fn temperature() float { return 0.3 }
    pub fn max_turns() uint { return 40 }
    pub fn handoff_to() List<str> { return ["tester", "reviewer"] }
}
