/// SSE (Server-Sent Events) incremental parser — Auto source.
///
/// Ported from the daemon's native `sse.rs` (rust-ref). Parses the
/// `text/event-stream` format used by LLM streaming APIs. Operates on `str`
/// chunks (like auto-ai-client's SseBuffer) — SSE is text, and str slice/find
/// operations are a2r-native. The transpiled Rust links into the daemon's
/// provider streaming path.
///
/// Feed raw text via `push()`, get complete `data:` payloads back.
///
/// Codegen note: this file deliberately uses `.slice()` / `.find()` / `.trim()`
/// (the proven auto-ai-client SseBuffer pattern) rather than `.substring()` or
/// custom find/split_once/trim_start helpers. The former transpile cleanly with
/// a single `str_find(&self.buf, ...)` sed borrow-fix; the latter triggered 5
// classes of a2r codegen defects (Plan 025 Phase 1).

// SseParser — accumulates text, yields complete `data:` payloads.
pub type SseParser {
    buf str
}

pub ext SseParser {
    pub fn new() SseParser {
        return SseParser(buf: "")
    }

    /// Feed a chunk of text. Returns complete SSE data fields parsed so far.
    pub mut fn push(chunk str) List<str> {
        self.buf = self.buf + chunk
        return self.drain_data()
    }

    /// Flush remaining buffer (call when stream ends).
    pub fn finish() List<str> {
        self.buf = self.buf + "\n\n"
        return self.drain_data()
    }

    mut fn drain_data() List<str> {
        var events List<str> = []
        loop {
            let frame = self.next_frame()
            if frame.is_empty() {
                break
            }
            let data = extract_data(frame)
            if data.is_empty() == false {
                events.push(data)
            }
        }
        return events
    }

    mut fn next_frame() str {
        // Try CRLF boundary first, then LF.
        let crlf = self.buf.find("\r\n\r\n")
        if crlf >= 0 {
            let frame = self.buf.slice(0, crlf)
            self.buf = self.buf.slice(crlf + 4)
            return frame
        }
        let lf = self.buf.find("\n\n")
        if lf >= 0 {
            let frame = self.buf.slice(0, lf)
            self.buf = self.buf.slice(lf + 2)
            return frame
        }
        return ""
    }
}

/// Extract the `data:` field from an SSE frame.
/// Returns "" for non-data events (ping, comments) and for the [DONE] signal.
/// (Empty string = "no data field"; callers distinguish via the original
/// `is_empty()` check that the rust-ref expressed as `Option::None`.)
fn extract_data(frame str) str {
    var parts List<str> = []
    for line in frame.split("\n") {
        if line.is_empty() {
            continue
        }
        if line.starts_with(":") {
            continue
        }
        let data = data_field(line)
        if data.is_empty() == false {
            parts.push(data)
        }
    }
    if parts.is_empty() {
        return ""
    }
    let data = parts.join("\n")
    if data == "[DONE]" {
        return ""
    }
    return data
}

/// If `line` is a `data: value` (or `data:value`) SSE field, return the value
/// with one leading space stripped (SSE spec: a single leading space after the
/// colon is part of the separator, not the value). Else return "".
///
/// Inlines str::split_once semantics via find+slice (a2r-native; avoids the
/// `.first()/.last()`-on-Option defect that the split_once helper hit).
fn data_field(line str) str {
    let colon = line.find(":")
    if colon < 0 {
        return ""
    }
    let key = line.slice(0, colon)
    if key.trim() != "data" {
        return ""
    }
    let value = line.slice(colon + 1)
    // SSE: exactly one leading space after ':' is the separator — strip it.
    if value.starts_with(" ") {
        return value.slice(1)
    }
    return value
}
