/// SSE (Server-Sent Events) incremental parser — Auto source.
///
/// Ported from the daemon's native `sse.rs` (rust-ref). Parses the
/// `text/event-stream` format used by LLM streaming APIs. This .at version
/// operates on `str` chunks (like auto-ai-client's SseBuffer) rather than raw
/// bytes — SSE is text, and str operations are a2r-native. The transpiled Rust
/// links into the daemon's provider streaming path.
///
/// Feed raw text via `push()`, get complete `data:` payloads back.

// SseParser — accumulates text, yields complete `data:` payloads.
pub type SseParser {
    buf str
}

pub ext SseParser {
    pub fn new() SseParser {
        return SseParser(buf: "")
    }

    /// Feed a chunk of text. Returns complete SSE data fields parsed so far.
    pub mut fn push(chunk str) List<str> {
        self.buf = self.buf + chunk
        return self.drain_data()
    }

    /// Flush remaining buffer (call when stream ends).
    pub fn finish() List<str> {
        self.buf = self.buf + "\n\n"
        return self.drain_data()
    }

    mut fn drain_data() List<str> {
        var events List<str> = []
        loop {
            is self.next_frame() {
                Some(frame) -> {
                    is extract_data(frame) {
                        Some(data) -> events.push(data),
                        None -> {}
                    }
                },
                None -> break
            }
        }
        return events
    }

    mut fn next_frame() ?str {
        // Try CRLF boundary first, then LF.
        is find_in_str(self.buf, "\r\n\r\n") {
            Some(pos) -> {
                let frame = self.buf.substring(0, pos)
                self.buf = self.buf.substring(pos + 4)
                return Some(frame)
            },
            None -> {}
        }
        is find_in_str(self.buf, "\n\n") {
            Some(pos) -> {
                let frame = self.buf.substring(0, pos)
                self.buf = self.buf.substring(pos + 2)
                return Some(frame)
            },
            None -> {}
        }
        return None
    }
}

/// Extract the `data:` field from an SSE frame.
/// Returns None for non-data events (ping, comments). Returns None for [DONE].
fn extract_data(frame str) ?str {
    var parts List<str> = []
    for line in frame.split("\n") {
        if line.is_empty() {
            continue
        }
        if line.starts_with(":") {
            continue
        }
        // SSE line format: "field:value" or "field: value".
        // Match rust-ref's split_once(':') + key.trim()=="data".
        is split_once(line, ":") {
            Some(pair) -> {
                let key = pair.first().trim()
                if key == "data" {
                    let value = pair.last()
                    parts.push(trim_start_spaces(value))
                }
            },
            None -> {}
        }
    }
    if parts.is_empty() {
        return None
    }
    let data = parts.join("\n")
    if data == "[DONE]" {
        return None
    }
    return Some(data)
}

// ─── string helpers (the daemon's sse.rs uses std byte ops; these str
//     equivalents let the .at stay a2r-native). ─────────────────────────────

/// Find the byte index of `needle` in `haystack`, or None.
/// (str.find returns ?uint in .at — wrap to ?str-free option via index check.)
fn find_in_str(haystack str, needle str) ?uint {
    let idx = haystack.find(needle)
    if idx < 0 {
        return None
    }
    return Some(idx)
}

/// Split `s` at the first occurrence of `sep`, returning (before, after).
/// Mirrors str::split_once. Returns None if `sep` not found.
fn split_once(s str, sep str) ?List<str> {
    let idx = s.find(sep)
    if idx < 0 {
        return None
    }
    let before = s.substring(0, idx)
    let after = s.substring(idx + sep.len())
    return Some([before, after])
}

/// Trim leading spaces (mirrors str::trim_start_matches(' ')).
fn trim_start_spaces(s str) str {
    var i uint = 0
    for i < s.len() {
        let ch = s.substring(i, i + 1)
        if ch != " " {
            break
        }
        i = i + 1
    }
    return s.substring(i)
}
